# Copy to `.env` to override defaults (loaded on import; shell/inline vars win).
# The defaults below are what the app uses with NO .env file at all — i.e. the
# repo runs fully offline out of the box.

# Model backend: "replay" (default, deterministic, offline, no GPU/key needed)
# or "live" (calls a real model — only needed to record new fixtures).
MODEL_MODE=replay

# --- Only used when MODEL_MODE=live ---
# Which live backend to talk to: "ollama" (local) or "openai" (any
# OpenAI-compatible endpoint, e.g. a free-tier hosted model).
LLM_BACKEND=ollama

# Ollama (LLM_BACKEND=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI-compatible (LLM_BACKEND=openai) — e.g. Groq / OpenRouter free tiers.
# No paid key required; free-tier keys work.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.1-8b-instant

# SQLite location (runtime task/trace store). Defaults to ./data/tasks.db.
# DB_PATH=./data/tasks.db
